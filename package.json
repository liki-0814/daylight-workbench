{
  "name": "daylight-workbench",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "web": "node server.mjs --open",
    "dev": "node --watch server.mjs",
    "dev:debug": "node --watch --inspect=127.0.0.1:9229 server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-timeout=30000",
    "desktop": "npm run pack:mac && open dist/native/Daylight.app",
    "pack:mac": "python3 scripts/build-native.py",
    "dist:mac": "python3 scripts/build-native.py --dmg",
    "test:native": "python3 test/native-test.py",
    "test:web-cli": "python3 test/web-cli-test.py",
    "test:contracts": "python3 test/task-contract-test.py",
    "test:focus-contracts": "python3 test/focus-contract-test.py",
    "test:native-focus-notifications": "python3 test/native-focus-notification-test.py",
    "benchmark:focus": "node scripts/benchmark-focus.mjs --records 10000,50000 --runtimes node,native",
    "test:native-focus-time-zone": "python3 test/native-focus-time-zone-test.py",
    "test:extensions-contracts": "python3 test/extensions-contract-test.py"
  },
  "description": "本地项目与任务工作台，支持 AI 对话与统一模型中转",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liki-0814/daylight-workbench.git"
  },
  "homepage": "https://github.com/liki-0814/daylight-workbench#readme",
  "bugs": {
    "url": "https://github.com/liki-0814/daylight-workbench/issues"
  },
  "author": "Daylight",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@qoder-ai/qoder-agent-sdk": "1.0.53",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "toml-eslint-parser": "^1.0.3",
    "undici": "7.30.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
